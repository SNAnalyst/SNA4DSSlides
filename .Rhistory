col    = "red",
lwd    = 2,
bty    = "n")
first_partition <- min(V(g)$partition)
last_partition  <- max(V(g)$partition)
observed_weight <- max_weight[end_id]
n_perm <- 1000
null_weights <- sapply(1:n_perm, function(x) {
# Create true independent copy of graph
el <- as.data.frame(cbind(as_edgelist(g), Freq = E(g)$Freq),
stringsAsFactors = FALSE)
el$Freq <- as.numeric(el$Freq)
# Permute weights within each partition pair
for (k in (first_partition + 1):last_partition) {
# Get partition of each edge endpoint
p1 <- V(g)$partition[match(el[, 1], V(g)$name)]
p2 <- V(g)$partition[match(el[, 2], V(g)$name)]
# Find edges between partition k-1 and k
edge_ids <- which(
(p1 == (k - 1) & p2 == k) |
(p1 == k       & p2 == (k - 1))
)
if (length(edge_ids) > 1) {
el$Freq[edge_ids] <- sample(el$Freq[edge_ids])
}
}
# Rebuild graph with permuted weights
g_null <- graph_from_data_frame(el,
vertices = data.frame(name = V(g)$name),
directed = FALSE)
V(g_null)$partition <- V(g)$partition
# Rerun dynamic programming
max_w <- rep(-Inf, vcount(g_null))
max_w[which(V(g_null)$partition == first_partition)] <- 0
for (k in (first_partition + 1):last_partition) {
current_ids <- which(V(g_null)$partition == k)
for (vid in current_ids) {
neigh_ids <- as.integer(neighbors(g_null, vid))
prev_ids  <- neigh_ids[V(g_null)$partition[neigh_ids] == (k - 1)]
if (length(prev_ids) == 0) next
prev_ids  <- prev_ids[is.finite(max_w[prev_ids])]
if (length(prev_ids) == 0) next
candidate_weights <- sapply(prev_ids, function(uid) {
eid <- get_edge_ids(g_null, c(uid, vid))
if (eid == 0) return(-Inf)
max_w[uid] + as.numeric(E(g_null)$Freq[eid])
})
best_idx <- which.max(candidate_weights)
if (length(best_idx) == 0) next
max_w[vid] <- candidate_weights[best_idx]
}
}
last_ids  <- which(V(g_null)$partition == last_partition)
reachable <- last_ids[is.finite(max_w[last_ids])]
if (length(reachable) == 0) return(NA)
max(max_w[reachable])
})
# Remove NAs
null_weights <- null_weights[!is.na(null_weights)]
# Compute p-value
p_value <- mean(null_weights >= observed_weight)
cat("Observed path weight:", observed_weight, "\n")
cat("Mean null weight:", mean(null_weights), "\n")
cat("SD null weight:", sd(null_weights), "\n")
cat("p-value:", p_value, "\n")
# Plot null distribution
hist(null_weights,
breaks = 30,
main   = "CUGT: Null distribution of maximum path weight",
xlab   = "Maximum path weight",
col    = "gray80",
border = "white")
abline(v = observed_weight, col = "red", lwd = 2)
legend("topright",
legend = paste0("Observed = ", round(observed_weight, 1),
"\np = ", round(p_value, 3)),
col    = "red",
lwd    = 2,
bty    = "n")
max_possible_weight <- nrow(scores) * (ncol(scores) - 1)
cat("Maximum possible path weight:", max_possible_weight, "\n")
cat("Observed path weight:", observed_weight, "\n")
cat("As % of maximum:", round(observed_weight / max_possible_weight * 100, 1), "%\n")
# Weight of each individual transition along the best path
cat("Weight per transition along best path:\n")
for (i in 1:(length(best_path_ids) - 1)) {
eid <- get_edge_ids(g, c(best_path_ids[i], best_path_ids[i + 1]))
w   <- E(g)$Freq[eid]
cat(V(g)$name[best_path_ids[i]], "->",
V(g)$name[best_path_ids[i + 1]],
": weight =", w,
"(", round(w / nrow(scores) * 100, 1), "% of sample)\n")
}
