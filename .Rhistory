odegree(0) +
gwidegree(0.1, fixed = TRUE) +
gwesp(0.1, fixed = TRUE, type = "OTP") +
absdiff("domain_D1_scale") +
absdiff("domain_D2_scale") +
absdiff("domain_D3_scale") +
absdiff("domain_D4_scale") +
absdiff("domain_D5_scale") +
nodematch("topic_mention_level", diff = TRUE) +
S(~gwesp(0.1, fixed = TRUE, type = "OTP"),
~topic_mention_level == "low") +
S(~gwesp(0.1, fixed = TRUE, type = "OTP"),
~topic_mention_level == "medium") +
S(~gwesp(0.1, fixed = TRUE, type = "OTP"),
~topic_mention_level == "high"),
control = ergm::control.ergm(MCMC.burnin = 5000,
MCMC.samplesize = 20000,
seed = 1234567,
MCMLE.maxit = 120,
parallel = 6,
parallel.type = "FORK")
)
