packageDescription("texreg")
install.packages("ergm.sign")
quit()
set.seed(123)
n <- 30
# Create undirected empty network
net1 <- network::network.initialize(n, directed = FALSE)
# Generate a symmetric random adjacency matrix
mat1 <- matrix(stats::rbinom(n * n, 1, 0.12), n, n)
mat1[lower.tri(mat1)] <- t(mat1)[lower.tri(mat1)]
diag(mat1) <- 0
net1[,] <- mat1
# Add nodal covariate
network::set.vertex.attribute(
net1,
"age",
stats::rnorm(n, mean = 40, sd = 10)
)
# Fit ERGM with interaction (expands internally)
fit1 <- ergm::ergm(
net1 ~ ergm::edges * ergm::nodecov("age")
)
# Fit ERGM with interaction (expands internally)
fit1 <- ergm::ergm(
net1 ~ edges * nodecov("age")
)
base::summary(fit1)
n <- 30
net2 <- network::network.initialize(n, directed = FALSE)
mat2 <- matrix(stats::rbinom(n * n, 1, 0.15), n, n)
mat2[lower.tri(mat2)] <- t(mat2)[lower.tri(mat2)]
diag(mat2) <- 0
net2[,] <- mat2
network::set.vertex.attribute(
net2,
"age",
stats::rnorm(n)
)
fit2 <- ergm::ergm(
net2 ~ ergm::edges + ergm::triangle * ergm::nodecov("age"),
control = ergm::control.ergm(
term.options = list(interact.dependent = "silent")
)
)
fit2 <- ergm::ergm(
net2 ~ edges + triangle * ergm::nodecov("age"),
control = ergm::control.ergm(
term.options = list(interact.dependent = "silent")
)
)
fit2 <- ergm::ergm(
net2 ~ edges + triangle * nodecov("age"),
control = ergm::control.ergm(
term.options = list(interact.dependent = "silent")
)
)
fit2 <- ergm::ergm(
net2 ~ edges + gwesp(0.5, fixed = TRUE) * nodecov("age"),
control = ergm::control.ergm(
term.options = list(interact.dependent = "silent")
)
)
# -----------------------------
# Create a more stable network
# (slightly higher density helps gwesp models converge)
# -----------------------------
n <- 40
net <- network::network.initialize(n, directed = FALSE)
mat <- matrix(stats::rbinom(n * n, 1, 0.20), n, n)
mat[lower.tri(mat)] <- t(mat)[lower.tri(mat)]
diag(mat) <- 0
net[,] <- mat
# nodal covariate
network::set.vertex.attribute(
net,
"age",
stats::rnorm(n)
)
# -----------------------------
# Stable ERGM with gwesp + interaction
# -----------------------------
fit <- ergm::ergm(
net ~ edges +
nodecov("age") +
gwesp(0.5, fixed = TRUE) +
gwesp(0.5, fixed = TRUE):nodecov("age"),
control = ergm::control.ergm(
term.options = list(interact.dependent = "silent"),
MCMC.burnin = 5000,
MCMC.interval = 1000,
MCMC.samplesize = 5000
)
)
# -----------------------------
# Stable ERGM with gwesp + interaction
# -----------------------------
fit <- ergm::ergm(
net ~ edges +
nodecov("age") +
gwesp(0.5, fixed = TRUE) +
gwesp(0.5, fixed = TRUE):nodecov("age"),
control = ergm::control.ergm(
term.options = list(interact.dependent = "silent"),
MCMC.burnin = 5000,
MCMC.interval = 1000,
MCMC.samplesize = 10000
)
)
