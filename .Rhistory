library(igraph)
# 1. Diagnostics
stopifnot(inherits(g, "igraph"))
print(vertex_attr_names(g))          # are 'community' and 'importance' there?
str(V(g)$community)
summary(V(g)$importance)
# 2. Make sure community is an integer 1..k
comm <- as.integer(as.factor(V(g)$community))
k <- max(comm)
# 3. Colours: always long enough
community_colors <- grDevices::hcl.colors(k, palette = "Set 2")
# 4. Sizes: guard against NA / negative values
imp <- V(g)$importance
imp[is.na(imp)] <- 0
imp <- pmax(imp, 0)
set.seed(1)
plot(
g,
layout            = layout_with_fr(g),
vertex.color      = community_colors[comm],
vertex.size       = 5 + 2 * imp,
vertex.label      = NA,
vertex.frame.color = "white",
edge.color        = "grey75",
edge.width        = 0.7,
main              = "Synthetic Network - 100 Nodes"
)
plot(
g,
layout = igraph::layout_with_fr(g),
vertex.color = community_colors[igraph::V(g)$community],
