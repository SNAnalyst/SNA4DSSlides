set.seed(123)
n <- 100
# Assign nodes to 3 communities
community <- rep(c("A", "B", "C"), length.out = n)
# Create node attributes
nodes <- data.frame(
name = paste0("Node_", 1:n),
community = community,
importance = runif(n, 1, 10),
type = sample(
c("Hub", "Regular", "Peripheral"),
n, replace = TRUE,
prob = c(0.15, 0.60, 0.25)
)
)
# Generate edges
edges <- data.frame(
from = character(),
to = character()
)
for (i in 1:(n-1)) {
for (j in (i+1):n) {
p <- if (community[i] == community[j]) 0.09 else 0.015
if (runif(1) < p) {
edges <- rbind(
edges,
data.frame(
from = paste0("Node_", i),
to = paste0("Node_", j)
)
)
}
}
}
# Create graph
g <- igraph::graph_from_data_frame(
edges,
directed = FALSE,
vertices = nodes
)
# Inspect network
print(g)
igraph::vcount(g)
igraph::ecount(g)
set.seed(123)
n <- 100
# Assign nodes to 3 communities
community <- rep(c("A", "B", "C"), length.out = n)
# Create node attributes
nodes <- data.frame(
name = paste0("Node_", 1:n),
community = community,
importance = runif(n, 1, 10),
type = sample(
c("Hub", "Regular", "Peripheral"),
n, replace = TRUE,
prob = c(0.15, 0.60, 0.25)
)
)
# Generate edges
edges <- data.frame(
from = character(),
to = character()
)
for (i in 1:(n-1)) {
for (j in (i+1):n) {
p <- if (community[i] == community[j]) 0.09 else 0.015
if (runif(1) < p) {
edges <- rbind(
edges,
data.frame(
from = paste0("Node_", i),
to = paste0("Node_", j)
)
)
}
}
}
# Create graph
g <- igraph::graph_from_data_frame(
edges,
directed = FALSE,
vertices = nodes
)
# Inspect network
print(g)
igraph::vcount(g)
igraph::ecount(g)
igraph::plot.igraph(
g,
layout = igraph::layout_with_fr(g),
vertex.color = community_colors[igraph::V(g)$community],
vertex.size = 5 + 2 * igraph::V(g)$importance,
vertex.label = NA,
vertex.frame.color = "white",
edge.color = "grey75",
edge.width = 0.7,
main = "Synthetic Network - 100 Nodes"
)
legend(
"topleft",
legend = names(community_colors),
col = community_colors,
pch = 19,
title = "Community",
bty = "n"
)
