# Homeplay Week 2
#
# 1) create a square matrix 3 x 3 filled with zeros
#
m <- matrix(0,3,3)
#
# 2) set as rownames and colnames the characters object that you find in the
# following list (in alphabetic order)
#
el <- list(c("A", "A"), c("A", "B"), c("A", "C"),
c("B", "A"), c("B", "B"), c("B", "C"),
c("C", "A"), c("C", "B"), c("C", "C"))
# TIP: extract ALL the characters and use the `unique()` function.
#
# solution
#
extr <- NULL
for (i in 1:length(el)) {
temp <- el[[i]]
extr <- append(extr, temp)
}
names <- unique(extr)
rownames(m) <- names
colnames(m) <- names
# 3) replace the 0s with 1 for
#
# - row 1 col 3
# - row 2 col 1
# - row 3 col 1
# - row 1 col 2
#
#
m[1,3] <-1
m[3,1] <-1
m[2,1] <-1
m[1,2] <-1
#
# 4) inspect m, what can you say about the matrix you just created?
#
m
print(m)
# print(m)
str(m)
summary(m)
# add two cols
D <- rep(0,3)
E <- D
m <- cbind(m, D, E)
m
D <- E <- rep(0,5)
m <- rbind(m, D, E)
