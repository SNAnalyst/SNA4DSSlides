"Q18" = "Cognitive Participation - Enrolment - S6",
"Q19" = "Cognitive Participation - Legitimation - S7",
"Q20" = "Cognitive Participation - Activation - S8",
"Q21" = "Collective Action - Interactional Workability - S9",
"Q22" = "Collective Action - Relational Integration - S10",
"Q23" = "Collective Action - Skill Set Workabiltiy - S11",
"Q24" = "Collective Action - Contextual Integration - S12",
"Q25" = "Reflexive Monitoring - Systematization - S13",
"Q26" = "Reflexive Monitoring - Communal Appraisal - S14",
"Q27" = "Reflexive Monitoring - Individual Appraisal - S15",
"Q28" = "Reflexive Monitoring - Reconfiguration - S16"
)
# Summary statistics
medians <- apply(scores, 2, median, na.rm = TRUE)
mins    <- apply(scores, 2, min,    na.rm = TRUE)
maxs    <- apply(scores, 2, max,    na.rm = TRUE)
modes   <- apply(scores, 2, function(x) {
x <- x[!is.na(x)]
as.numeric(names(which.max(table(x))))
})
# Summary dataframe
summary_df <- data.frame(
question = unname(custom_labels[names(medians)]),
median   = medians,
mode     = modes,
min      = mins,
max      = maxs,
position = seq_along(medians)
)
# Reverse question order so Q1 appears at the top
summary_df$question <- factor(summary_df$question, levels = rev(summary_df$question))
sep_lines <- seq(4.5, nrow(summary_df) - 0.5, by = 4)
# quartz()
ggplot(summary_df, aes(x = median, y = question)) +
# Alternating background bands per group of 4
annotate("rect",
xmin = -Inf, xmax = Inf,
ymin = seq(0.5, 15.5, by = 8), ymax = seq(4.5, 16.5, by = 8),
fill = "gray90", alpha = 0.4) +
# Range bar from min to max
geom_errorbarh(aes(xmin = min, xmax = max),
height = 0.4,
linewidth = 0.7,
color = "steelblue") +
# Median point
geom_point(aes(x = median, color = "Median"),
size  = 4,
shape = 16) +
# Mode point
geom_point(aes(x = mode, color = "Mode"),
size  = 4,
shape = 18) +
# Red horizontal separator lines
geom_hline(yintercept = sep_lines, linetype = "dashed",
color = "red", linewidth = 0.5) +
scale_x_continuous(limits = c(1, 7), breaks = 1:7) +
scale_color_manual(name   = NULL,
values = c("Median" = "black",
"Mode"   = "red")) +
labs(
x     = "Response (1–7)",
y     = NULL,
title = "Median and Mode with Min–Max Range"
) +
theme_minimal(base_size = 16) +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor   = element_blank(),
axis.text.y        = element_text(size = 14, hjust = 1),
axis.text.x        = element_text(size = 14),
axis.title.x       = element_text(size = 15),
plot.title         = element_text(face = "bold", size = 18, margin = margin(b = 10)),
plot.margin        = margin(10, 20, 10, 10),
legend.position    = "bottom",
legend.text        = element_text(size = 14)
)
# Observed total path weight
observed_weight <- max_weight[end_id]
cat("Observed path weight:", observed_weight, "\n")
# Number of permutations
n_perm <- 1000
# Null distribution: permute edge weights within each consecutive partition pair
null_weights <- sapply(1:n_perm, function(x) {
# Copy graph
g_null <- g
# Permute weights within each partition pair separately
for (k in (first_partition + 1):last_partition) {
# Get edges between partition k-1 and k
edge_ids <- which(
(V(g)$partition[ends(g, E(g))[, 1]] == (k - 1) &
V(g)$partition[ends(g, E(g))[, 2]] == k) |
(V(g)$partition[ends(g, E(g))[, 2]] == (k - 1) &
V(g)$partition[ends(g, E(g))[, 1]] == k)
)
if (length(edge_ids) > 1) {
E(g_null)$Freq[edge_ids] <- sample(E(g_null)$Freq[edge_ids])
}
}
# Rerun dynamic programming on permuted graph
max_w  <- rep(-Inf, vcount(g_null))
pred   <- rep(NA_integer_, vcount(g_null))
max_w[which(V(g_null)$partition == first_partition)] <- 0
for (k in (first_partition + 1):last_partition) {
current_ids <- which(V(g_null)$partition == k)
for (vid in current_ids) {
neigh_ids <- as.integer(neighbors(g_null, vid))
prev_ids  <- neigh_ids[V(g_null)$partition[neigh_ids] == (k - 1)]
if (length(prev_ids) == 0) next
prev_ids  <- prev_ids[is.finite(max_w[prev_ids])]
if (length(prev_ids) == 0) next
candidate_weights <- sapply(prev_ids, function(uid) {
eid <- get_edge_ids(g_null, c(uid, vid))
if (eid == 0) return(-Inf)
max_w[uid] + as.numeric(E(g_null)$Freq[eid])
})
best_idx <- which.max(candidate_weights)
if (length(best_idx) == 0) next
max_w[vid]  <- candidate_weights[best_idx]
pred[vid]   <- prev_ids[best_idx]
}
}
last_ids  <- which(V(g_null)$partition == last_partition)
reachable <- last_ids[is.finite(max_w[last_ids])]
if (length(reachable) == 0) return(NA)
max(max_w[reachable])
})
first_partition <- min(V(g)$partition)
last_partition  <- max(V(g)$partition)
