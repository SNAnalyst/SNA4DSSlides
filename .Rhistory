job::job(pkgcheck = {
pkg <- file.path("D:", "Dropbox", "R", "eigen_packages", "=git", pkgname)
checkDir <- file.path("D:", "dropbox", "R", "eigen_packages", "==checkDir", pkgname)
try(file.remove(file.path("D:/Dropbox/R/eigen_packages/=git", pkgname, "NAMESPACE")), silent = TRUE)
